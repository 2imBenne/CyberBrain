# Dùng chung cho docker-compose (khớp mặc định trong application.yml)
DB_NAME=cyberbrain
DB_USERNAME=cyberbrain
DB_PASSWORD=cyberbrain_secret
DB_HOST=localhost
DB_PORT=5432

# Production Render + Neon: set chuỗi kết nối duy nhất này (override DB_* ở trên)
# DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/cyberbrain?sslmode=require

# JWT secrets (bắt buộc đổi khi deploy Render)
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
