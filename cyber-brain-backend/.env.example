# Dùng chung cho docker-compose (khớp mặc định trong application.yml)
DB_NAME=cyberbrain
DB_USERNAME=cyberbrain
DB_PASSWORD=cyberbrain_secret
DB_HOST=localhost
DB_PORT=5432

# JWT secrets (bắt buộc đổi khi deploy Railway)
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
